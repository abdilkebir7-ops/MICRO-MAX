# production requires strong JWT_SECRET / ROUTER_ENCRYPTION_KEY (server refuses to start otherwise)
NODE_ENV=production
# true when running behind nginx/Caddy (needed for correct rate limiting)
TRUST_PROXY=true
PORT=8080
# Comma-separated exact origins for browsers. The Android app sends no Origin, so it can stay empty.
# Never use * in production.
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://micromax:change-this-in-development@db:5432/micromax
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-at-least-32-chars
ROUTER_ENCRYPTION_KEY=replace-with-a-different-random-secret-at-least-32-chars
# Only true for local development with self-signed RouterOS certificates.
ALLOW_INSECURE_ROUTER_TLS=false
ENABLE_ONLINE_PAYMENTS=false
GOOGLE_CLIENT_ID=replace-with-google-web-client-id
BINANCE_PAY_CERTIFICATE_SN=replace-with-binance-pay-certificate-sn
BINANCE_PAY_SECRET_KEY=replace-with-binance-pay-secret-key
BINANCE_PAY_CURRENCY=USDT
BINANCE_PAY_TERMINAL_TYPE=APP
BINANCE_PAY_BASE_URL=https://bpay.binanceapi.com
# Configure this exact HTTPS endpoint in Binance Pay Merchant Portal:
# BINANCE_PAY_WEBHOOK_URL=https://your-domain.example/api/webhooks/binance-pay
NITA_WEBHOOK_SECRET=replace-me
VISA_WEBHOOK_SECRET=replace-me
