# LOCAL RELEASE SIGNING TEMPLATE
# Copy this file to keystore.properties in the project root (gitignored).
# Do not commit this file after adding real passwords.
#
# Recommended production approach: enable Google Play App Signing and keep the
# upload keystore in a password manager or CI secret manager.
#
# Generate a new upload key once, outside the repository:
# keytool -genkeypair -v -keystore "$HOME/.keys/micromax-upload.jks" \
#   -alias micromax-upload -keyalg RSA -keysize 4096 -validity 10000
#
# Local Android Gradle release commands:
# ./gradlew :app:signingReport
# ./gradlew :app:bundleRelease
#
# For CI, use these equivalent GitHub Actions secrets instead:
# MICROMAX_KEYSTORE_BASE64, MICROMAX_KEYSTORE_PASSWORD,
# MICROMAX_KEY_ALIAS, MICROMAX_KEY_PASSWORD

storeFile=../micromax-release.jks
storePassword=replace-with-keystore-password
keyAlias=micromax-upload
keyPassword=replace-with-key-password
