# Copy to backend/.env  (docker compose reads it via env_file)
NODE_ENV=production
PORT=8080
# docker compose sets DATABASE_URL itself; for plain `npm start` use e.g.:
# DATABASE_URL=postgresql://micromax:PASSWORD@localhost:5432/micromax

# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
ROUTER_ENCRYPTION_KEY=

# Public HTTPS URL of THIS server. REQUIRED for Agent mode (routers call this address).
PUBLIC_BASE_URL=https://micro-max-api.onrender.com
# Comma-separated explicit origins (never *) in production
CORS_ORIGIN=
TRUST_PROXY=true
# true = أي شخص ينشئ حسابه (التطبيق العام)، وكل حساب معزول عن غيره. false = الحساب الأول فقط.
ALLOW_REGISTRATION=true
GOOGLE_CLIENT_ID=

# --- Router network safety ---
# Cloud deployment (Render): keep false. Local deployment on the same LAN as the routers: true.
ALLOW_PRIVATE_ROUTER_HOSTS=false
# Ports the backend may connect to when adding direct (API / API-SSL) routers
ROUTER_ALLOWED_PORTS=8728,8729
# Ports allowed for the HotSpot portal URL check
PORTAL_ALLOWED_PORTS=80,443,8080,8443
# Never enable in production; use certificate pinning (fingerprint) instead
ALLOW_INSECURE_ROUTER_TLS=false

# --- Optional online payments (off by default) ---
ENABLE_ONLINE_PAYMENTS=false

# Timezone used for the "peak hours" insight
APP_TIMEZONE=Africa/Tripoli
